# ============================================================================
# My Best DataBase - Variables de entorno
# Copia este archivo como ".env" y completa los valores. NUNCA subas .env a git.
# ============================================================================

# Puerto del servidor web
PORT=3000

# Clave para firmar los tokens de sesión (JWT). Obligatoria: mínimo 32 caracteres aleatorios.
# Genérala con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Cuenta de Gmail que envía los códigos de verificación del registro
EMAIL_USER=cuenta@gmail.com
# Contraseña de aplicación de Google (16 caracteres; NO es la contraseña normal de la cuenta)
EMAIL_PASS_APP=

# (Opcional) Orígenes externos autorizados a llamar la API, separados por coma.
# Déjalo vacío si solo usas la interfaz que sirve este mismo servidor.
CORS_ORIGIN=

# (Opcional) En "production" el servidor no arranca si JWT_SECRET falta o es débil.
# NODE_ENV=production
